# Copy this file to .env on the production server. Never commit that real .env file.
# The image is published by the GitHub Actions workflow.
APP_IMAGE=ghcr.io/your-github-owner/fill4you:latest

APP_NAME=fill4you
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=info
PUBLIC_BASE_URL=https://fill4you.example.com
ALLOWED_HOSTS=["fill4you.example.com"]
CORS_ALLOWED_ORIGINS=["https://when2meet.com","https://www.when2meet.com"]

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=fill4you_session
SESSION_COOKIE_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true

POSTGRES_DB=fill4you
POSTGRES_USER=fill4you
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-unique-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Configure this exact HTTPS callback in the Google OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fill4you.example.com/auth/google/callback
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_SYNC_PAST_DAYS=7
GOOGLE_SYNC_FUTURE_DAYS=90
GOOGLE_SYNC_INTERVAL_MINUTES=15

# Create a remotely managed Cloudflare Tunnel and configure its public hostname to use
# http://app:8000 as its service URL. Treat this token as a production secret.
CLOUDFLARE_TUNNEL_TOKEN=
