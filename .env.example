APP_NAME=fill4you
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
POSTGRES_DB=fill4you
POSTGRES_USER=fill4you
POSTGRES_PASSWORD=fill4you
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Runtime and session configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=info
DEVELOPMENT_USER_EMAIL=developer@fill4you.local
SESSION_COOKIE_NAME=fill4you_session
SESSION_SAME_SITE=lax
# SESSION_COOKIE_DOMAIN=example.com
# SESSION_HTTPS_ONLY=true
# JSON list, needed when the bookmarklet API is introduced.
CORS_ALLOWED_ORIGINS=[]

# Google OAuth. Add http://localhost:8000/auth/google/callback to the client redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
